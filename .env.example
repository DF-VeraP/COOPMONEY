# ==============================================================================
# COOPMONEY - Archivo de Configuración de Entorno de Ejemplo (.env.example)
# Copia este archivo a .env y completa con las credenciales de tu servidor/despliegue
# ==============================================================================

# Entorno de ejecución (development | production)
NODE_ENV=production

# Puerto de escucha del servidor Node.js
PORT=3000

# Cadena de conexión a Base de Datos PostgreSQL
# Formato: postgresql://<usuario>:<password>@<host>:<puerto>/<nombre_base_datos>
DATABASE_URL="postgres://postgres:tu_password_aqui@localhost:5432/coopmoney_bd"

# Llave secreta para la firma y verificación de JSON Web Tokens (JWT)
# Se recomienda una cadena aleatoria de al menos 32 caracteres en producción
JWT_SECRET="genera_una_clave_secreta_fuerte_aqui_para_produccion"

# ------------------------------------------------------------------------------
# Configuración del Servicio de Correo Transaccional (SMTP / Nodemailer)
# ------------------------------------------------------------------------------
# Para cuentas de Google (Gmail):
# 1. Habilitar Verificación en dos pasos.
# 2. Generar una "Contraseña de Aplicación" de 16 caracteres.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="tu_correo_institucional@gmail.com"
SMTP_PASS="tu_contrasena_de_aplicacion_google"
SMTP_FROM="COOPMONEY <tu_correo_institucional@gmail.com>"
